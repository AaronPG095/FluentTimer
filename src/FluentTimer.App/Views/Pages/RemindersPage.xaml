<UserControl
    x:Class="FluentTimer.App.Views.Pages.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="DaysTemplate">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource DayToggle}" Content="{Binding Letter}" ToolTip="{Binding Name}"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <TextBlock Text="Reminders &amp; alarms" Style="{StaticResource PageTitle}" />

            <!-- Interval reminders -->
            <Grid Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Interval reminders" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Repeat every N minutes during active hours. They pause while your screen is locked or you're away, and restart when you're back." />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="ReminderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="12,0" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Tag="{Binding}" Click="OnDeleteReminder" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                        <TextBlock Text="Every" Style="{StaticResource BodyText}" Margin="0,0,8,0" />
                                        <ui:NumberBox Value="{Binding IntervalMinutes, Mode=TwoWay}" Minimum="1" Maximum="600" Width="120" MaxDecimalPlaces="0" />
                                        <TextBlock Text="min" Style="{StaticResource BodyText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                        <TextBlock Text="From" Style="{StaticResource BodyText}" Margin="0,0,8,0" />
                                        <ui:TextBox Text="{Binding From}" Width="76" />
                                        <TextBlock Text="to" Style="{StaticResource BodyText}" Margin="8,0" />
                                        <ui:TextBox Text="{Binding To}" Width="76" />
                                    </StackPanel>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DaysTemplate}" Margin="0,0,20,8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Break countdown" IsChecked="{Binding HasBreak, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <ui:TextBox Text="{Binding BreakText}" Width="76" Margin="8,0,0,0" ToolTip="e.g. 20s, 5m"
                                                    IsEnabled="{Binding HasBreak}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnAddReminder">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Add reminder" />
                </StackPanel>
            </Button>

            <!-- Alarms -->
            <StackPanel Margin="0,28,0,8">
                <TextBlock Text="Alarms" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Style="{StaticResource MutedText}" Text="Go off at a clock time. Pick weekdays to repeat; leave them empty for a one-off. Tip: type 'at 14:30 lunch' in quick add." />
            </StackPanel>

            <ItemsControl x:Name="AlarmList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <ui:TextBox Grid.Column="1" Text="{Binding Time}" Width="84" FontFamily="{StaticResource MonoFont}" FontSize="16" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="2">
                                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="2,4,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource DaysTemplate}" Margin="12,0" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Tag="{Binding}" Click="OnDeleteAlarm" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnAddAlarm">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Add alarm" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
