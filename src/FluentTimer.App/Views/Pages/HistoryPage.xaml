<UserControl
    x:Class="FluentTimer.App.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <Grid>
                <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox x:Name="RangeBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnRangeChanged">
                        <ComboBoxItem Content="Today" />
                        <ComboBoxItem Content="This week" />
                        <ComboBoxItem Content="Last 7 days" />
                        <ComboBoxItem Content="This month" />
                        <ComboBoxItem Content="All time" />
                    </ComboBox>
                    <Button Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="OnExport">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Content="Clear" Click="OnClear" />
                </StackPanel>
            </Grid>

            <!-- Summary strip -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Tracked" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="TotalText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Sessions" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="CountText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Completed" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="CompletedText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="By label" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="NoTotals" Style="{StaticResource MutedText}" Text="Nothing tracked in this period yet. Finished timers and focus sessions show up here; add a label (e.g. 'Client X 25m') to group them." />
                    <ItemsControl x:Name="TotalsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,0,16,0"
                                                 Foreground="{DynamicResource OverlayAccentBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SessionsText}" Style="{StaticResource MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SessionsTitle" Text="Sessions" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border x:Name="SessionsCard" Style="{StaticResource Card}" Padding="8,6">
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Span}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource BodyText}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Column="5" Text="{Binding Check}" Style="{StaticResource Glyph}" Foreground="{DynamicResource OverlayAccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
