<UserControl
    x:Class="FluentTimer.App.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <Grid>
                <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox x:Name="RangeBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnRangeChanged">
                        <ComboBoxItem Content="Today" />
                        <ComboBoxItem Content="This week" />
                        <ComboBoxItem Content="Last 7 days" />
                        <ComboBoxItem Content="This month" />
                        <ComboBoxItem Content="All time" />
                    </ComboBox>
                    <Button Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="OnExport">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Content="Clear" Click="OnClear" />
                </StackPanel>
            </Grid>

            <!-- Summary strip -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Tracked" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="TotalText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Sessions" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="CountText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Completed" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="CompletedText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Pomodoros" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="PomodoroText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Interruptions" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="InterruptionText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource OverlayForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Daily stacked bars (built in code) -->
            <TextBlock Text="Per day" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel x:Name="Legend" Margin="0,0,0,10" />
                    <Grid Height="150">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AxisMax" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Top" />
                        <TextBlock Text="0" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,18" />
                        <Border Grid.Column="1" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Opacity="0.6" />
                        <Grid x:Name="Bars" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="By label" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="NoTotals" Style="{StaticResource MutedText}" Text="Nothing tracked in this period yet. Finished timers and focus sessions show up here; add a label (e.g. 'Client X 25m') to group them." />
                    <ItemsControl x:Name="TotalsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,0,16,0"
                                                 Foreground="{DynamicResource OverlayAccentBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SessionsText}" Style="{StaticResource MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,8">
                <TextBlock x:Name="SessionsTitle" Text="Sessions" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Click="OnToggleAdd">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add session" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Add a forgotten session -->
            <Border x:Name="AddCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Label" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="AddLabel" Width="200" PlaceholderText="e.g. Client X" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Date" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <DatePicker x:Name="AddDate" Width="150" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Start" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="AddStart" Width="80" Text="09:00" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Length" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="AddLength" Width="90" Text="25m" ToolTip="e.g. 25m, 1h30" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="Add" Padding="18,6" Click="OnAdd" />
                        <TextBlock x:Name="AddError" Style="{StaticResource MutedText}" Foreground="{DynamicResource AlertBrush}" Margin="10,0,0,0" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border x:Name="SessionsCard" Style="{StaticResource Card}" Padding="8,6">
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Span}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" />
                                <ui:TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="(no label)" Margin="0,0,10,0" Padding="8,3"
                                            ToolTip="Edit the label; it saves when you leave the box" />
                                <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource BodyText}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Column="5" Text="{Binding Check}" Style="{StaticResource Glyph}" Foreground="{DynamicResource OverlayAccentBrush}" />
                                <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete session"
                                        AutomationProperties.Name="Delete session" Tag="{Binding}" Click="OnDeleteSession" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
