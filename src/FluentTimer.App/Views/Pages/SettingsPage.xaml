<UserControl
    x:Class="FluentTimer.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FluentTimer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <DataTemplate x:Key="AlertEditor" DataType="{x:Type vm:AlertEditorVm}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="{Binding}" Click="OnTestAlert">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="Test" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="Visual" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <WrapPanel>
                        <CheckBox Content="Flash red" IsChecked="{Binding Flash, Mode=TwoWay}" Margin="0,0,20,4" />
                        <CheckBox Content="Grow / pulse" IsChecked="{Binding Grow, Mode=TwoWay}" Margin="0,0,20,4" />
                        <CheckBox Content="Glow" IsChecked="{Binding Glow, Mode=TwoWay}" Margin="0,0,20,4" />
                        <CheckBox Content="Dim the screen" IsChecked="{Binding DimOverlay, Mode=TwoWay}" Margin="0,0,20,4" />
                    </WrapPanel>

                    <TextBlock Text="Sound" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <WrapPanel>
                        <ComboBox ItemsSource="{x:Static vm:AlertEditorVm.SoundChoices}" SelectedItem="{Binding SoundChoice, Mode=TwoWay}"
                                  Width="160" Margin="0,0,8,6" Tag="{Binding}" SelectionChanged="OnSoundChanged" />
                        <TextBlock Text="{Binding CustomPath}" Style="{StaticResource MutedText}" Margin="0,0,16,6" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" Foreground="{DynamicResource NoResultsForeground}" Margin="0,0,8,0" />
                            <Slider Width="140" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Content="Repeat until dismissed" IsChecked="{Binding LoopSound, Mode=TwoWay}" Margin="0,0,20,6" />
                        <CheckBox Content="Escalate if ignored for 1 min" IsChecked="{Binding Escalate, Mode=TwoWay}" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Launch at startup" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Starts quietly in the tray when you sign in to Windows" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Quick-add shortcut" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ui:TextBox x:Name="HotkeyBox" HorizontalAlignment="Right" Width="200" IsReadOnly="True" Text="{Binding Hotkey, Mode=OneWay}"
                                    PlaceholderText="Press a shortcut…" PreviewKeyDown="OnHotkeyKeyDown" ToolTip="Click, then press the new shortcut" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Preset buttons (minutes)" Style="{StaticResource BodyText}" />
                        <ui:TextBox HorizontalAlignment="Right" Width="200" Text="{Binding Presets}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Snooze length (minutes)" Style="{StaticResource BodyText}" />
                        <ui:NumberBox HorizontalAlignment="Right" Width="140" Minimum="1" Maximum="120" MaxDecimalPlaces="0" Value="{Binding SnoozeMinutes, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Away after (minutes idle)" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Interval reminders pause while you're away or the screen is locked" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="140" Minimum="1" Maximum="120" MaxDecimalPlaces="0" Value="{Binding IdleMinutes, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Widget -->
            <TextBlock Text="Floating widget" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Show the widget" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Drag it anywhere; it snaps to screen edges. Alerts always show it." Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowWidget, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Show when no timer is running" Style="{StaticResource BodyText}" />
                            <TextBlock Text="A slim bar you can hover to start a timer" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowWhenIdle, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <ContentPresenter Content="{Binding TimerAlert}" ContentTemplate="{StaticResource AlertEditor}" />
            <ContentPresenter Content="{Binding BreakAlert}" ContentTemplate="{StaticResource AlertEditor}" />
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Quiet during full-screen apps" Style="{StaticResource BodyText}" />
                        <TextBlock Text="No sound or screen dim while a game, video or presentation is full-screen; the widget still flashes" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding QuietWhenFullscreen, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Pomodoro -->
            <TextBlock Text="Pomodoro" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Focus (min)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <ui:NumberBox Width="130" Minimum="1" Maximum="240" MaxDecimalPlaces="0" Value="{Binding WorkMinutes, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Short break (min)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <ui:NumberBox Width="130" Minimum="1" Maximum="120" MaxDecimalPlaces="0" Value="{Binding ShortBreakMinutes, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Long break (min)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <ui:NumberBox Width="130" Minimum="1" Maximum="120" MaxDecimalPlaces="0" Value="{Binding LongBreakMinutes, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Long break every" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <ui:NumberBox Width="130" Minimum="1" Maximum="12" MaxDecimalPlaces="0" Value="{Binding LongBreakEvery, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="Start breaks automatically" IsChecked="{Binding AutoStartBreaks, Mode=TwoWay}" Margin="0,4" />
                    <CheckBox Content="Start the next focus session automatically" IsChecked="{Binding AutoStartWork, Mode=TwoWay}" Margin="0,4" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Theme" Style="{StaticResource BodyText}" />
                        <ComboBox HorizontalAlignment="Right" Width="200" ItemsSource="{x:Static vm:SettingsVm.ThemeChoices}" SelectedItem="{Binding Theme, Mode=TwoWay}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Accent colour" Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:TextBox Width="110" Margin="0,0,8,0" Text="{Binding CustomAccent}" PlaceholderText="#0078D4"
                                        Visibility="{Binding IsCustomAccent, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Width="200" ItemsSource="{x:Static vm:SettingsVm.AccentChoices}" SelectedItem="{Binding Accent, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="Fluent Timer " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Content="Open data folder" Click="OnOpenData" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
