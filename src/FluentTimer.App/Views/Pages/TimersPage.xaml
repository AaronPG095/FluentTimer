<UserControl
    x:Class="FluentTimer.App.Views.Pages.TimersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,16">
            <TextBlock Text="Timers" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="Quick" FontSize="14"
                                    PlaceholderText="25m  ·  Tea 4m  ·  1h repeat  ·  at 14:30 lunch  ·  pomo writing"
                                    TextChanged="OnQuickChanged" KeyDown="OnQuickKeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="18,6" Click="OnQuickStart">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="Start" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="QuickPreview" Style="{StaticResource MutedText}" Margin="2,8,0,0"
                               Text="Type a duration and an optional label. Add a time with 'at' for an alarm." />
                    <WrapPanel x:Name="Presets" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Saved timers: named countdowns started with one click -->
            <Grid Margin="0,16,0,8">
                <TextBlock Text="Saved timers" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Padding="10,4" Click="OnAddSaved">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Add saved timer" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="SavedEmpty" Style="{StaticResource MutedText}" Margin="2,0,0,4"
                       Text="Keep timers you use often here. Click Save on a running timer, or add one, then start it with one click." />
            <ItemsControl x:Name="SavedItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,6,6" Padding="14,10">
                            <StackPanel>
                                <Grid>
                                    <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Tag="Name this timer"
                                             MinWidth="180" MaxWidth="230" HorizontalAlignment="Left" FontSize="14"
                                             AutomationProperties.Name="Saved timer name" PreviewKeyDown="OnSavedFieldKeyDown" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;"
                                            HorizontalAlignment="Right" ToolTip="Delete saved timer" AutomationProperties.Name="Delete saved timer"
                                            Tag="{Binding}" Click="OnDeleteSaved" />
                                </Grid>
                                <!-- Countdown: length + repeat -->
                                <StackPanel x:Name="CountdownFields" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Style="{StaticResource InlineEdit}" Text="{Binding DurationText, UpdateSourceTrigger=LostFocus}"
                                             Width="76" Margin="-7,0,6,0" FontSize="13" FontWeight="Normal" Tag="25m"
                                             FontFamily="{StaticResource MonoFont}" ToolTip="Length, e.g. 25m, 1h, 1h30, 90s"
                                             AutomationProperties.Name="Saved timer length" PreviewKeyDown="OnSavedFieldKeyDown" />
                                    <ToggleButton Style="{StaticResource ChipToggle}" Padding="10,4" IsChecked="{Binding Repeat, Mode=TwoWay}"
                                                  ToolTip="Repeat: dismissing the finished timer starts it again" AutomationProperties.Name="Repeat">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="Repeat" FontSize="12" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <!-- Pomodoro: planned sessions + the current lengths -->
                                <StackPanel x:Name="PomodoroFields" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Sessions" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                    <TextBox Style="{StaticResource InlineEdit}" Text="{Binding PlannedText, UpdateSourceTrigger=LostFocus}"
                                             Width="44" Margin="-2,0,8,0" FontSize="13" FontWeight="Normal" Tag="∞"
                                             ToolTip="Planned focus sessions (1–16); empty or ∞ keeps going" AutomationProperties.Name="Planned sessions"
                                             PreviewKeyDown="OnSavedFieldKeyDown" />
                                    <TextBlock Text="{Binding PomodoroSummary}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <ToggleButton Style="{StaticResource ChipToggle}" Padding="10,4" HorizontalAlignment="Left" IsChecked="{Binding IsPomodoro, Mode=TwoWay}"
                                                  ToolTip="Run this as a Pomodoro (focus and breaks) instead of a plain countdown" AutomationProperties.Name="Pomodoro">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="Pomodoro" FontSize="12" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Style="{StaticResource AccentButton}" Padding="12,4" HorizontalAlignment="Right" Tag="{Binding}" Click="OnStartSaved"
                                            AutomationProperties.Name="Start saved timer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0" Foreground="White" />
                                            <TextBlock Text="Start" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPomodoro}" Value="True">
                                <Setter TargetName="CountdownFields" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PomodoroFields" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Running" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <Border x:Name="Empty" Style="{StaticResource Card}" Padding="16,20">
                <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="No timers running. Start one above, from the widget, or press " /><Run x:Name="HotkeyRun" FontWeight="SemiBold" /><Run Text=" anywhere." />
                </TextBlock>
            </Border>

            <ItemsControl x:Name="TimerItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Tag="{Binding NamePlaceholder}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="200"
                                             ToolTip="Click to name or rename this timer" AutomationProperties.Name="Timer name"
                                             PreviewKeyDown="OnNameKeyDown" />

                                    <!-- Pomodoro: phase badge, position in the set, today's count vs goal, and the plan -->
                                    <WrapPanel x:Name="PomoRow" Margin="0,6,0,2" Visibility="Collapsed">
                                        <Border x:Name="PhaseBadge" CornerRadius="4" Padding="7,1" Margin="0,0,10,2" VerticalAlignment="Center"
                                                Background="{DynamicResource OverlayAccentBrush}">
                                            <TextBlock Text="{Binding PhaseText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SetDots}" VerticalAlignment="Center" Margin="0,0,10,2"
                                                      ToolTip="Position in the set; a long break comes after the last dot">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse x:Name="D" Width="9" Height="9" Margin="0,0,4,0" Fill="{DynamicResource SetDotEmptyBrush}"
                                                             StrokeThickness="0" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="done">
                                                            <Setter TargetName="D" Property="Fill" Value="{DynamicResource OverlayAccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="current">
                                                            <Setter TargetName="D" Property="Fill" Value="Transparent" />
                                                            <Setter TargetName="D" Property="Stroke" Value="{DynamicResource OverlayAccentBrush}" />
                                                            <Setter TargetName="D" Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource MutedText}" Margin="0,0,10,2" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2"
                                                    ToolTip="Planned focus sessions for this task. It finishes after the last one; ∞ keeps going.">
                                            <TextBlock Text="Plan" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="10" Content="&#xE949;"
                                                    AutomationProperties.Name="Fewer planned sessions" Tag="{Binding Id}" Click="OnPlanMinus" />
                                            <TextBlock Text="{Binding PlanText}" Style="{StaticResource BodyText}" FontSize="12" MinWidth="34" TextAlignment="Center" />
                                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="10" Content="&#xE948;"
                                                    AutomationProperties.Name="More planned sessions" Tag="{Binding Id}" Click="OnPlanPlus" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                    <TextBlock x:Name="Time" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OverlayForegroundBrush}" Margin="0,6,0,6" />
                                    <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" MaxWidth="520" HorizontalAlignment="Stretch"
                                                 Foreground="{DynamicResource OverlayAccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="{Binding Id}" Click="OnPause">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding PauseGlyph}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding PauseText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="{Binding Id}" Click="OnReset"
                                            ToolTip="Restart from the original length and keep running">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Reset" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton x:Name="RepeatToggle" Style="{StaticResource ChipToggle}" Margin="0,0,6,0" Visibility="Collapsed"
                                                  IsChecked="{Binding Repeat, Mode=TwoWay}" AutomationProperties.Name="Repeat"
                                                  ToolTip="When on, dismissing the finished timer starts it again">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Repeat" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Style="{StaticResource ChipButton}" Content="+1 min" Margin="0,0,6,0" Tag="{Binding Id}" Click="OnAdd1" />
                                    <Button Style="{StaticResource ChipButton}" Content="+5 min" Margin="0,0,6,0" Tag="{Binding Id}" Click="OnAdd5" />
                                    <Button x:Name="Skip" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Skip to next phase"
                                            Tag="{Binding Id}" Click="OnSkip" Visibility="Collapsed" />
                                    <Button x:Name="SaveBtn" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save as a saved timer"
                                            AutomationProperties.Name="Save timer" Tag="{Binding Id}" Click="OnSaveRunning" Visibility="Collapsed" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancel" Tag="{Binding Id}" Click="OnCancel" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPomodoro}" Value="True">
                                <Setter TargetName="Skip" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PomoRow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SaveBtn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnBreak}" Value="True">
                                <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource BreakBrush}" />
                                <Setter TargetName="PhaseBadge" Property="Background" Value="{DynamicResource BreakBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                                <Setter TargetName="RepeatToggle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SaveBtn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource AlertBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter TargetName="Time" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
