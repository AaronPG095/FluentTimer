<ui:FluentWindow
    x:Class="FluentTimer.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Fluent Timer"
    Width="980" Height="700" MinWidth="780" MinHeight="540"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    Background="{DynamicResource ContentBackgroundBrush}"
    Foreground="{DynamicResource OverlayForegroundBrush}"
    FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Fluent Timer" Grid.Row="0" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/FluentTimer.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (FO settings nav rail) -->
            <Border Background="{DynamicResource TabStripBackground}" BorderBrush="{DynamicResource ColumnDividerBrush}"
                    BorderThickness="0,1,1,0" Padding="6,8,6,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0">
                        <TextBlock Text="Quick add anywhere" Style="{StaticResource MutedText}" FontSize="11" />
                        <Border HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="4" Padding="6,2"
                                Background="{DynamicResource OverlayAccentBrush}">
                            <TextBlock x:Name="HotkeyBadge" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnNavChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Tag="Timers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Margin="0,0,12,0" />
                                <TextBlock Text="Timers" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Reminders">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" Margin="0,0,12,0" />
                                <TextBlock Text="Reminders &amp; alarms" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="History">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" Margin="0,0,12,0" />
                                <TextBlock Text="History" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,12,0" />
                                <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="{DynamicResource ColumnDividerBrush}" BorderThickness="0,1,0,0">
                <ContentControl x:Name="PageHost" Margin="24,16,12,0" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
