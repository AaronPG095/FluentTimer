<Window
    x:Class="FluentTimer.App.Views.DimOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fluent Timer break"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="{DynamicResource ScrimBrush}"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    FontFamily="{StaticResource UiFont}"
    Opacity="0">
    <!-- Positioned in code at the centre of the widget's monitor (the window spans every monitor). -->
    <Border x:Name="Card" HorizontalAlignment="Left" VerticalAlignment="Top" Width="440" Padding="32,28"
            Background="{DynamicResource ColumnCardBrush}" BorderBrush="{DynamicResource OverlayAccentBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="28" Foreground="{DynamicResource OverlayAccentBrush}" Margin="0,0,0,12" />
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource OverlayForegroundBrush}" />
            <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="CountdownText" FontFamily="{StaticResource MonoFont}" FontSize="56" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="{DynamicResource OverlayForegroundBrush}" Margin="0,16,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="SnoozeButton" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="OnSnooze" />
                <Button x:Name="DismissButton" Style="{StaticResource AccentButton}" Padding="20,6" Click="OnDismiss" />
            </StackPanel>
            <TextBlock Text="Esc to dismiss" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</Window>
